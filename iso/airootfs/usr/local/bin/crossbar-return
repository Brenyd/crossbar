#!/bin/bash
# From the Plasma desktop: make Crossbar the login session again, then log out
# (the login manager logs straight back in, into Crossbar).
set -u
if [[ -f "$HOME/.config/ps5-next-session" ]] && grep -q '>>> crossbar >>>' /etc/profile.d/ps5-tty-session.sh 2>/dev/null; then
  # PS5 setup: pick Crossbar in its session switcher, then end this session
  echo crossbar >"$HOME/.config/ps5-next-session"
  if pgrep -u "$(id -u)" -f gamescope-session >/dev/null; then
    steam -shutdown >/dev/null 2>&1 &         # gaming mode: Steam quits, the session ends
    sleep 8
    pkill -u "$(id -u)" -f gamescope-session || true
    exit 0
  fi
  if ! grep -q 'Return to Crossbar" from Plasma' /etc/profile.d/ps5-tty-session.sh; then
    # this switcher has no hook after Plasma (it would start gaming mode): end the whole
    # desktop session instead, so tty1 logs in again and reads "crossbar"
    sid=${XDG_SESSION_ID:-$(loginctl show-user "$(id -u)" -p Display --value 2>/dev/null)}
    [[ -n "$sid" ]] && loginctl terminate-session "$sid" && exit 0
  fi
  out='"ok": true'
elif [[ -f "$HOME/.config/crossbar/boot-session" ]]; then
  # TTY autologin setup: choose Crossbar, then log out; tty1 logs back in and starts it
  echo crossbar >"$HOME/.config/crossbar/boot-session"
  out='"ok": true'
else
out=$(echo '{"session":"crossbar"}' | pkexec /usr/lib/crossbar/admin.py boot-session 2>&1)
fi
if ! grep -q '"ok": true' <<<"$out"; then
  msg="Couldn't switch to Crossbar: $out"
  command -v kdialog >/dev/null && kdialog --error "$msg" || echo "$msg" >&2
  exit 1
fi
if command -v qdbus6 >/dev/null; then
  qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout && exit 0
fi
if command -v qdbus >/dev/null; then
  qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout && exit 0
fi
loginctl terminate-session "${XDG_SESSION_ID:-}"
