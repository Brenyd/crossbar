#!/usr/bin/env bash
# Prints what Crossbar can see — paste the output when reporting a problem.
#   crossbar-doctor            print the report
#   crossbar-doctor --share    upload it and print a short link to share
if [[ "${1:-}" == "--share" ]]; then
  out=$(mktemp)
  "$0" >"$out" 2>&1
  # drop anything that looks like a secret before it leaves the machine
  grep -viE 'token|password|passwd|secret|api_key|apikey|cookie' "$out" >"$out.clean"
  url=$(curl -s --max-time 30 --data-binary @"$out.clean" https://paste.rs 2>/dev/null)
  if [[ "$url" != https://* ]]; then
    url=$(curl -s --max-time 30 -F "file=@$out.clean" https://0x0.st 2>/dev/null)
  fi
  rm -f "$out" "$out.clean"
  if [[ "$url" == https://* ]]; then echo "$url"; else echo "upload failed"; exit 1; fi
  exit 0
fi
echo "== Crossbar doctor  $(date)"
echo "user: $(id)"
echo
echo "== crossbard diagnostics"
curl -s http://127.0.0.1:7777/api/diagnostics | python3 -m json.tool 2>/dev/null || echo "crossbard is not running (see ~/.cache/crossbard.log)"
echo
echo "== controller device nodes"
for n in /dev/input/event*; do
  name=$(cat /sys/class/input/$(basename "$n")/device/name 2>/dev/null)
  if udevadm info -q property -n "$n" 2>/dev/null | grep -q '^ID_INPUT_JOYSTICK=1'; then
    printf '%-20s %-40s %s  readable:%s\n' "$n" "$name" "$(stat -c '%U:%G %a' "$n")" "$([ -r "$n" ] && echo yes || echo NO)"
  fi
done
echo "/dev/uinput: $(stat -c '%U:%G %a' /dev/uinput 2>/dev/null || echo missing)  writable:$([ -w /dev/uinput ] && echo yes || echo NO)"
echo
echo "== windows (sway)"
swaymsg -t get_tree -r 2>/dev/null | python3 -c '
import json,sys
def walk(n):
    if n.get("pid"):
        print(("* " if n.get("focused") else "  ") + str(n.get("app_id") or (n.get("window_properties") or {}).get("class")) + "  |  " + str(n.get("name")) + "  marks=" + str(n.get("marks")))
    for c in n.get("nodes",[]) + n.get("floating_nodes",[]): walk(c)
walk(json.load(sys.stdin))' || echo "not in the sway session"
echo
echo "== controller service (crossbar-inputd)"
systemctl is-active crossbar-inputd 2>/dev/null; ls -l /run/crossbar/input.sock 2>/dev/null || echo "no socket"
journalctl -u crossbar-inputd -n 8 --no-pager 2>/dev/null
echo
echo "== overlay (crossbar-overlay)"
pgrep -af overlay.py || echo "overlay not running"
tail -n 8 ~/.cache/crossbar-overlay.log 2>/dev/null
echo
echo "== screen capture (Discord Share Screen)"
for p in xdg-desktop-portal xdg-desktop-portal-wlr; do pacman -Q "$p" 2>/dev/null || echo "$p: NOT installed"; done
systemctl --user is-active xdg-desktop-portal.service xdg-desktop-portal-wlr.service 2>&1 | paste -sd' ' | sed 's/^/portal services: /'
systemctl --user show-environment 2>/dev/null | grep -E '^(WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP)=' | paste -sd' ' | sed 's/^/activation env: /'
echo
echo "== last lines of ~/.cache/crossbard.log"
tail -n 25 ~/.cache/crossbard.log 2>/dev/null
